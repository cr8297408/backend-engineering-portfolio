---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/react/ui/Navbar';
import { withBase } from '../lib/paths';
import { pillars } from '../data/skills';
---

<Layout title="About - Backend Engineer Portfolio">
  <Navbar client:load />
  <div class="min-h-screen bg-black px-4 py-24">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-16">
        <a
          href={withBase("/")}
          class="inline-flex items-center text-white/60 hover:text-white transition-all duration-200 mb-8"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Home
        </a>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium text-white mb-6">
          About Me
        </h1>
        <p class="text-xl text-white/60">
          Backend Engineer specializing in scalable systems and clean architecture
        </p>
      </div>

      <!-- Content Sections -->
      <div class="space-y-8">
        <!-- Introduction -->
        <section class="bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10">
          <h2 class="text-2xl font-medium text-white mb-4">Introduction</h2>
          <p class="text-white/60 leading-relaxed mb-4">
            I'm a backend engineer passionate about building scalable, maintainable systems that solve real-world problems.
            With expertise in microservices architecture, cloud infrastructure, and distributed systems, I focus on creating
            solutions that are both technically excellent and business-driven.
          </p>
          <p class="text-white/60 leading-relaxed">
            This portfolio documents that work the way an engineer would want to receive it: the real architecture of each
            system, how it is provisioned and deployed, and the reasoning behind the decisions that shape it.
          </p>
        </section>

        <!-- Skills -->
        <section class="bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10">
          <h2 class="text-2xl font-medium text-white mb-2">Technical Skills</h2>
          <p class="text-white/50 text-sm mb-8">
            The four blocks that carry most of the work.
            <a href={withBase("/#skills")} class="text-blue-300/80 underline underline-offset-4 decoration-blue-300/30 hover:text-blue-200 transition-colors duration-200">See the full inventory</a>.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {pillars.map((pillar) => (
              <div>
                <h3 class="text-lg font-medium text-blue-300 mb-3">{pillar.title}</h3>
                <ul class="flex flex-wrap gap-2">
                  {pillar.highlights.map((item) => (
                    <li class="px-3 py-1.5 bg-white/5 text-white/70 text-sm rounded-full border border-white/10">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <!-- What Makes This Portfolio Different -->
        <section class="bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10">
          <h2 class="text-2xl font-medium text-white mb-8">What Makes This Portfolio Different</h2>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-500/20 rounded-2xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-white mb-2">Interactive Architecture Diagrams</h3>
                <p class="text-white/50 text-sm leading-relaxed">
                  Explore system designs by clicking on components to see detailed explanations of each service, database, and integration point.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-emerald-500/20 rounded-2xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-white mb-2">The Reasoning Behind Each Decision</h3>
                <p class="text-white/50 text-sm leading-relaxed">
                  Every project states what makes it work and the trade-offs each choice carries, down to individual components.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-purple-500/20 rounded-2xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-white mb-2">Infrastructure Visualization</h3>
                <p class="text-white/50 text-sm leading-relaxed">
                  Where a project is deployed, a second diagram covers provisioning, networking, TLS and the release pipeline.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA -->
        <section class="text-center py-16">
          <h2 class="text-3xl md:text-4xl font-medium text-white mb-4">
            Let's Build Something Great Together
          </h2>
          <p class="text-white/60 mb-8">
            Interested in working together or want to discuss a project?
          </p>
          <a
            href={withBase("/projects")}
            class="inline-block px-8 py-4 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
          >
            View My Projects
          </a>
        </section>
      </div>
    </div>
  </div>
</Layout>
