---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/react/ui/Navbar';
import { ProjectCard } from '../components/react/ui/ProjectCard';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

// Load all projects
const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));
const projects = projectFiles.map(file => {
  const content = readFileSync(join(projectsDir, file), 'utf-8');
  return JSON.parse(content);
}).filter(p => p.featured).slice(0, 4); // Show up to 4 featured projects

const skills = {
  languages: ['TypeScript', 'Go', 'Python', 'Node.js'],
  databases: ['PostgreSQL', 'MongoDB', 'Redis', 'Elasticsearch'],
  infrastructure: ['Docker', 'Kubernetes', 'AWS', 'Terraform'],
  patterns: ['Microservices', 'Event-Driven', 'CQRS', 'DDD']
};
---

<Layout title="Backend Engineer Portfolio - Building Scalable Systems">
  <!-- Navbar -->
  <Navbar client:load />

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <!-- Background Video -->
    <div class="absolute inset-0 z-0">
      <video
        src="/background.mp4"
        autoplay
        loop
        muted
        playsinline
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-4xl mx-auto text-center px-4">
      <h1 class="text-6xl md:text-7xl lg:text-8xl font-medium mb-8 text-white tracking-tight">
        Backend<br/>Engineer
      </h1>
      <p class="text-xl md:text-2xl text-white/90 mb-12 max-w-2xl mx-auto font-light leading-relaxed">
        Where scalable systems and clean<br class="hidden md:block"/> architecture come together
      </p>
      <a
        href="#projects"
        class="inline-block px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20 backdrop-blur-sm"
      >
        View Projects
      </a>
      <p class="mt-6 text-sm text-white/50">
        <a href="#about" class="hover:text-white/80 transition-colors underline underline-offset-4">Learn more about me</a>
      </p>
    </div>

    <!-- Bottom gradient fade -->
    <div class="absolute bottom-0 left-0 right-0 h-64 bg-gradient-to-t from-black to-transparent z-20 pointer-events-none"></div>
  </section>

  <!-- About Section -->
  <section id="about" class="pt-32 pb-12 px-4 bg-black">
    <div class="max-w-5xl mx-auto">
      <!-- Main Statement -->
      <div class="text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium text-white mb-8 leading-tight">
          Backend engineer passionate about<br class="hidden md:block"/> building scalable, maintainable systems.
        </h2>
        <p class="text-lg md:text-xl text-white/60 leading-relaxed max-w-3xl mx-auto">
          With expertise in microservices architecture, cloud infrastructure, and distributed systems, 
          I focus on creating solutions that are both technically excellent and business-driven.
        </p>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="pt-12 pb-24 px-4 bg-black">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-medium text-white mb-16 text-center">
        Technical Skills
      </h2>
      <div class="grid md:grid-cols-2 gap-4">
        <!-- Languages Card -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              </div>
              <h3 class="text-xl font-medium text-white">Languages</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skills.languages.map((skill) => (
                <span class="px-4 py-2 bg-white/5 text-white/70 rounded-full text-sm border border-white/10 hover:bg-white/10 hover:text-white transition-all duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Databases Card -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
                </svg>
              </div>
              <h3 class="text-xl font-medium text-white">Databases</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skills.databases.map((skill) => (
                <span class="px-4 py-2 bg-white/5 text-white/70 rounded-full text-sm border border-white/10 hover:bg-white/10 hover:text-white transition-all duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Infrastructure Card -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-orange-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-orange-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
              </div>
              <h3 class="text-xl font-medium text-white">Infrastructure</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skills.infrastructure.map((skill) => (
                <span class="px-4 py-2 bg-white/5 text-white/70 rounded-full text-sm border border-white/10 hover:bg-white/10 hover:text-white transition-all duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>

        <!-- Architecture Card -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-xl bg-purple-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <h3 class="text-xl font-medium text-white">Architecture</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              {skills.patterns.map((skill) => (
                <span class="px-4 py-2 bg-white/5 text-white/70 rounded-full text-sm border border-white/10 hover:bg-white/10 hover:text-white transition-all duration-200">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-24 px-4 bg-black">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h3 class="text-xl md:text-4xl lg:text-5xl font-medium text-white mb-8 leading-tight">What Makes This Portfolio Different</h3>
        <p class="text-lg md:text-xl text-white/60 leading-relaxed max-w-3xl mx-auto">
          This portfolio showcases my work through interactive architecture diagrams and live API demonstrations, giving you a hands-on view of how my projects are built and how they work. 
        </p>
      </div>

      <!-- What Makes Me Different -->
      <div class="grid md:grid-cols-3 gap-6 mb-20">
        <!-- Interactive Architecture -->
        <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-blue-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-medium text-white mb-3">Interactive Diagrams</h3>
          <p class="text-white/50 text-sm leading-relaxed">
            Explore system designs by clicking on components to see detailed explanations of each service and integration point.
          </p>
        </div>

        <!-- Live API Testing -->
        <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
          </div>
          <h3 class="text-xl font-medium text-white mb-3">Live API Testing</h3>
          <p class="text-white/50 text-sm leading-relaxed">
            Test endpoints directly from the browser. See request/response flows visualized in real-time.
          </p>
        </div>

        <!-- Infrastructure -->
        <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-purple-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
            </svg>
          </div>
          <h3 class="text-xl font-medium text-white mb-3">Cloud Infrastructure</h3>
          <p class="text-white/50 text-sm leading-relaxed">
            View infrastructure setups with detailed breakdowns of networking, security, and deployment strategies.
          </p>
        </div>
      </div>

      <!-- Gallery Grid - Masonry style -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project, index) => (
          <div class:list={[
            index === 0 && "md:col-span-2 lg:col-span-1 lg:row-span-2",
            index === 1 && "lg:col-span-2",
          ]}>
            <ProjectCard
              title={project.title}
              description={project.longDescription}
              technologies={project.technologies}
              slug={project.slug}
              featured={project.featured}
              github={project.github}
              image={project.image}
              client:load
            />
          </div>
        ))}
      </div>

      <div class="text-center mt-16">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          View All Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-32 px-4 bg-black">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium text-white mb-6">
        Let's Work Together
      </h2>
      <p class="text-lg text-white/60 mb-12">
        Interested in collaborating or have a project in mind?<br class="hidden md:block"/> Let's discuss how we can build something great together.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a
          href="mailto:your.email@example.com"
          class="px-8 py-4 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
        >
          Send Email
        </a>
        <a
          href="https://github.com/yourusername"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/yourprofile"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-4 bg-black border-t border-white/10">
    <div class="max-w-6xl mx-auto text-center text-white/40 text-sm">
      <p>© {new Date().getFullYear()} Backend Engineer Portfolio. Built with Astro and React.</p>
    </div>
  </footer>
</Layout>
