---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/react/ui/Navbar';
import { ProjectCard } from '../components/react/ui/ProjectCard';
import { withBase } from '../lib/paths';
import HeroTopology from '../components/HeroTopology.astro';
import { pillars, skillGroups } from '../data/skills';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

// Load all projects
const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));
const projects = projectFiles.map(file => {
  const content = readFileSync(join(projectsDir, file), 'utf-8');
  return JSON.parse(content);
}).filter(p => p.featured).slice(0, 4); // Show up to 4 featured projects

---

<Layout title="Cesar Ruiz Portfolio - Backend Engineer">
  <!-- Navbar -->
  <Navbar client:load />

  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <HeroTopology />

    <!-- Content -->
    <div class="relative z-10 max-w-4xl mx-auto text-center px-6 py-28">
      <p class="hero-eyebrow mb-6 text-xs md:text-sm font-medium uppercase tracking-[0.28em] text-blue-300/80">
        Cesar Ruiz — Backend Engineer
      </p>
      <h1 class="hero-title text-[2.6rem] leading-[1.05] sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 text-white tracking-tight text-balance">
        Systems you can<br class="hidden sm:block"/> inspect, not just read about
      </h1>
      <p class="hero-sub text-lg md:text-xl text-white/70 mb-10 max-w-xl mx-auto font-light leading-relaxed text-balance">
        Every project here ships with its real architecture diagram, how it is deployed, and the reasoning behind each decision.
      </p>
      <div class="hero-actions flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a
          href="#projects"
          class="w-full sm:w-auto px-8 py-4 bg-white text-black rounded-full hover:bg-blue-50 transition-colors duration-200 font-medium"
        >
          Explore the projects
        </a>
        <a
          href="#about"
          class="w-full sm:w-auto px-8 py-4 bg-white/5 text-white/80 rounded-full hover:bg-white/10 hover:text-white transition-colors duration-200 font-medium border border-white/15"
        >
          About me
        </a>
      </div>
    </div>

    <!-- Scroll cue -->
    <a
      href="#about"
      aria-label="Scroll to the About section"
      class="scroll-cue absolute bottom-8 left-1/2 -translate-x-1/2 z-10 p-3 rounded-full text-white/40 hover:text-white/90 transition-colors duration-200"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </section>

  <!-- About Section -->
  <section id="about" class="py-24 px-4 bg-black">
    <div class="max-w-5xl mx-auto">
      <!-- Main Statement -->
      <div class="text-center">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium text-white mb-8 leading-tight">
          Backend engineer passionate about<br class="hidden md:block"/> building scalable, maintainable systems.
        </h2>
        <p class="text-lg md:text-xl text-white/60 leading-relaxed max-w-3xl mx-auto">
          With expertise in microservices architecture, cloud infrastructure, and distributed systems, 
          I focus on creating solutions that are both technically excellent and business-driven.
        </p>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="pt-12 pb-28 px-4 bg-black">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-medium text-white mb-4">Technical Skills</h2>
        <p class="text-lg text-white/60 max-w-2xl mx-auto">
          Four blocks carry most of the work. The full inventory is below them.
        </p>
      </div>

      <!-- The four differentiating blocks -->
      <div class="grid md:grid-cols-2 gap-4 mb-20">
        {pillars.map((pillar) => (
          <div class="group relative rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-8 transition-colors duration-300 hover:border-white/25">
            <h3 class="text-xl font-medium text-white mb-3">{pillar.title}</h3>
            <p class="text-white/55 leading-relaxed mb-6">{pillar.summary}</p>
            <ul class="flex flex-wrap gap-2">
              {pillar.highlights.map((item) => (
                <li class="rounded-full border border-blue-400/20 bg-blue-400/10 px-3 py-1 text-sm text-blue-100/85">
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Full inventory -->
      <h3 class="text-sm font-medium uppercase tracking-[0.22em] text-white/40 mb-8">
        Full inventory
      </h3>
      <div class="skill-columns">
        {skillGroups.map((group) => (
          <section class="skill-group">
            <h4 class="text-xs font-medium uppercase tracking-[0.16em] text-blue-300/70 mb-3">
              {group.title}
            </h4>
            <ul class="space-y-1.5">
              {group.items.map((item) => (
                <li class="text-sm leading-snug text-white/60">{item}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>


  <!-- Projects Section -->
  <section id="projects" class="py-24 px-4 bg-black">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20">
        <h3 class="text-xl md:text-4xl lg:text-5xl font-medium text-white mb-8 leading-tight">What Makes This Portfolio Different</h3>
        <p class="text-lg md:text-xl text-white/60 leading-relaxed max-w-3xl mx-auto">
          Every project is documented the way an engineer would want to receive it: the real architecture, how it is deployed, and the reasoning behind each decision.
        </p>
      </div>

      <!-- What Makes Me Different -->
      <div class="grid md:grid-cols-3 gap-6 mb-20">
        <!-- Interactive Architecture -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-2xl bg-blue-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium text-white mb-3">Interactive Diagrams</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Explore system designs by clicking on components to see detailed explanations of each service and integration point.
            </p>
          </div>
        </div>

        <!-- Design decisions -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium text-white mb-3">The Reasoning, Not a Feature List</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Each project explains the decisions that shape it and the trade-offs they carry, down to individual components.
            </p>
          </div>
        </div>

        <!-- Infrastructure -->
        <div class="group relative bg-gradient-to-br from-white/[0.07] to-white/[0.02] rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
          <div class="absolute inset-0 bg-gradient-to-br from-purple-500/10 to-transparent rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative">
            <div class="w-12 h-12 rounded-2xl bg-purple-500/20 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
              </svg>
            </div>
            <h3 class="text-xl font-medium text-white mb-3">Cloud Infrastructure</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Where a project is deployed, a second diagram covers provisioning, networking, TLS and the release pipeline.
            </p>
          </div>
        </div>
      </div>

      <!-- Featured projects -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.description}
            technologies={project.technologies}
            slug={project.slug}
            featured={project.featured}
            github={project.github}
            diagram={project.diagrams?.architecture}
            client:visible
          />
        ))}
      </div>

      <div class="text-center mt-16">
        <a
          href={withBase("/projects")}
          class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          View All Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-32 px-4 bg-black">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-medium text-white mb-6">
        Let's Work Together
      </h2>
      <p class="text-lg text-white/60 mb-12">
        Interested in collaborating or have a project in mind?<br class="hidden md:block"/> Let's discuss how we can build something great together.
      </p>
      <div class="flex gap-4 justify-center flex-wrap">
        <a
          href="mailto:cesarbyte4bit@gmail.com"
          class="px-8 py-4 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
        >
          Send Email
        </a>
        <a
          href="https://github.com/cr8297408"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/cesarbackend"
          target="_blank"
          rel="noopener noreferrer"
          class="px-8 py-4 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
        >
          LinkedIn
        </a>
      </div>
      <p class="mt-8 text-sm text-white/40">
        Or reach me directly at
        <a
          href="mailto:cesarbyte4bit@gmail.com"
          class="text-white/70 underline underline-offset-4 decoration-white/25 hover:text-white hover:decoration-white/60 transition-colors duration-200"
        >cesarbyte4bit@gmail.com</a>
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-8 px-4 bg-black border-t border-white/10">
    <div class="max-w-6xl mx-auto text-center text-white/40 text-sm">
      <p>© {new Date().getFullYear()} Cesar Ruiz. Built with Astro and React.</p>
    </div>
  </footer>
</Layout>

<style>
  /* Quiet load-in: the hero settles into place once, rather than animating on
     every interaction. Replaces a hover effect that blurred the headline
     under the cursor — it made the page's own title unreadable. */
  .hero-eyebrow,
  .hero-title,
  .hero-sub,
  .hero-actions {
    animation: hero-rise 0.7s cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }
  .hero-eyebrow { animation-delay: 0.05s; }
  .hero-title   { animation-delay: 0.15s; }
  .hero-sub     { animation-delay: 0.28s; }
  .hero-actions { animation-delay: 0.4s; }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* A 28-group inventory reads better flowing down narrow columns than
     wrapping across a grid, and CSS columns keep it a single DOM list —
     so browser find-in-page still works on every entry. */
  .skill-columns {
    column-gap: 2.5rem;
    columns: 1;
  }

  .skill-group {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .skill-columns { columns: 2; }
  }

  @media (min-width: 1024px) {
    .skill-columns { columns: 3; }
  }

  @media (min-width: 1280px) {
    .skill-columns { columns: 4; }
  }

  .scroll-cue svg {
    animation: cue-drift 2.4s ease-in-out infinite;
  }

  @keyframes cue-drift {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow,
    .hero-title,
    .hero-sub,
    .hero-actions,
    /* A 28-group inventory reads better flowing down narrow columns than
     wrapping across a grid, and CSS columns keep it a single DOM list —
     so browser find-in-page still works on every entry. */
  .skill-columns {
    column-gap: 2.5rem;
    columns: 1;
  }

  .skill-group {
    break-inside: avoid;
    margin-bottom: 2rem;
  }

  @media (min-width: 640px) {
    .skill-columns { columns: 2; }
  }

  @media (min-width: 1024px) {
    .skill-columns { columns: 3; }
  }

  @media (min-width: 1280px) {
    .skill-columns { columns: 4; }
  }

  .scroll-cue svg {
      animation: none;
    }
  }
</style>
