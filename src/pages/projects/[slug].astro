---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/react/ui/Navbar';
import { ArchitectureDiagram } from '../../components/react/diagram/ArchitectureDiagram';
import { EndpointTabs } from '../../components/react/api/EndpointTabs';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
  const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));

  return projectFiles.map(file => {
    const content = readFileSync(join(projectsDir, file), 'utf-8');
    const project = JSON.parse(content);
    return {
      params: { slug: project.slug },
      props: { project }
    };
  });
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Backend Engineer Portfolio`} description={project.longDescription}>
  <!-- Navbar -->
  <Navbar client:load />

  <div class="min-h-screen bg-black px-4 py-24">
    <div class="max-w-7xl mx-auto">
      <!-- Back Button -->
      <a
        href="/projects"
        class="inline-flex items-center text-white/60 hover:text-white transition-all duration-200 mb-8"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Projects
      </a>

      <!-- Project Header -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
          <div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium text-white mb-4">{project.title}</h1>
            <p class="text-xl text-white/60 max-w-3xl">{project.longDescription}</p>
          </div>
          {project.featured && (
            <span class="inline-block px-4 py-2 bg-white/10 text-white text-sm font-medium rounded-full border border-white/20">
              Featured
            </span>
          )}
        </div>

        <!-- Technologies -->
        <div class="flex flex-wrap gap-2 mb-8">
          {project.technologies.map((tech: string) => (
            <span class="px-4 py-2 bg-white/5 text-white/70 text-sm rounded-full border border-white/10">
              {tech}
            </span>
          ))}
        </div>

        <!-- Project Links -->
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        )}
      </div>

      <!-- Architecture Diagram Section -->
      {project.diagrams?.architecture && (
        <section class="mb-20">
          <div class="mb-8">
            <h2 class="text-2xl md:text-3xl font-medium text-white mb-3">System Architecture</h2>
            <p class="text-white/60">
              Interactive diagram showing the components and their relationships
            </p>
          </div>
          <div class="bg-neutral-950 rounded-3xl border border-white/10 overflow-hidden">
            <ArchitectureDiagram
              diagram={project.diagrams.architecture}
              client:visible
            />
          </div>
        </section>
      )}

      <!-- API Testing Section -->
      {project.api && project.api.endpoints.length > 0 && (
        <section class="mb-20">
          <div class="mb-8">
            <h2 class="text-2xl md:text-3xl font-medium text-white mb-3">API Testing</h2>
            <p class="text-white/60">
              Test endpoints and visualize the request flow through the system
            </p>
          </div>

          <div class="bg-neutral-950 rounded-3xl border border-white/10 overflow-hidden">
            <EndpointTabs
              endpoints={project.api.endpoints}
              diagramNodes={project.diagrams.architecture.nodes}
              diagramEdges={project.diagrams.architecture.edges}
              client:load
            />
          </div>
        </section>
      )}

      <!-- Key Features -->
      <section class="mb-20">
        <h2 class="text-2xl md:text-3xl font-medium text-white mb-8">Key Features</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-2">Scalability</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Designed to handle high traffic with horizontal scaling and load balancing
            </p>
          </div>
          <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-2">Resilience</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Implements circuit breakers, retries, and graceful degradation
            </p>
          </div>
          <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-purple-500/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-2">Observability</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Comprehensive logging, monitoring, and distributed tracing
            </p>
          </div>
          <div class="group relative bg-gradient-to-br from-white/[0.05] to-transparent rounded-3xl p-8 border border-white/10 hover:border-white/20 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-orange-500/20 flex items-center justify-center mb-4">
              <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>
            <h3 class="text-lg font-medium text-white mb-2">Performance</h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Optimized for low latency with caching and efficient data access
            </p>
          </div>
        </div>
      </section>

      <!-- Related Projects -->
      <section class="pt-16 border-t border-white/10">
        <div class="text-center">
          <h2 class="text-2xl font-medium text-white mb-6">Explore More Projects</h2>
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
          >
            View All Projects
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
