---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/react/ui/Navbar';
import { ArchitectureDiagram } from '../../components/react/diagram/ArchitectureDiagram';
import { EndpointTabs } from '../../components/react/api/EndpointTabs';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
  const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));

  return projectFiles.map(file => {
    const content = readFileSync(join(projectsDir, file), 'utf-8');
    const project = JSON.parse(content);
    return {
      params: { slug: project.slug },
      props: { project }
    };
  });
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Backend Engineer Portfolio`} description={project.longDescription}>
  <!-- Navbar -->
  <Navbar client:load />

  <div class="min-h-screen px-4 py-24">
    <div class="max-w-7xl mx-auto">
      <!-- Back Button -->
      <a
        href="/#projects"
        class="inline-flex items-center text-text-secondary hover:text-accent-blue transition-all duration-200 mb-8"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Projects
      </a>

      <!-- Project Header -->
      <div class="mb-12">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">{project.title}</h1>
            <p class="text-xl text-text-secondary">{project.longDescription}</p>
          </div>
          {project.featured && (
            <span class="px-3 py-1 bg-accent-blue/10 text-accent-blue text-sm font-semibold rounded-full">
              Featured
            </span>
          )}
        </div>

        <!-- Technologies -->
        <div class="flex flex-wrap gap-2 mb-6">
          {project.technologies.map((tech: string) => (
            <span class="px-3 py-1.5 bg-surface-secondary text-text-primary text-sm rounded-lg border border-border-primary">
              {tech}
            </span>
          ))}
        </div>

        <!-- Project Links -->
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 bg-surface-secondary text-text-primary rounded-lg hover:bg-accent-blue hover:text-white transition-all duration-200 font-medium border border-border-primary"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        )}
      </div>

      <!-- Architecture Diagram Section -->
      {project.diagrams?.architecture && (
        <section class="mb-16">
          <div class="mb-6">
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-2">System Architecture</h2>
            <p class="text-text-secondary">
              Interactive diagram showing the components and their relationships
            </p>
          </div>
          <ArchitectureDiagram
            diagram={project.diagrams.architecture}
            client:visible
          />
        </section>
      )}

      <!-- API Testing Section -->
      {project.api && project.api.endpoints.length > 0 && (
        <section class="mb-16">
          <div class="mb-6">
            <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-2">API Testing</h2>
            <p class="text-text-secondary">
              Test endpoints and visualize the request flow through the system
            </p>
          </div>

          <EndpointTabs
            endpoints={project.api.endpoints}
            diagramNodes={project.diagrams.architecture.nodes}
            diagramEdges={project.diagrams.architecture.edges}
            client:load
          />
        </section>
      )}

      <!-- Key Features -->
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-6">Key Features</h2>
        <div class="grid md:grid-cols-2 gap-6">
          <div class="bg-surface-primary border border-border-primary rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-text-primary mb-2">Scalability</h3>
            <p class="text-text-secondary">
              Designed to handle high traffic with horizontal scaling and load balancing
            </p>
          </div>
          <div class="bg-surface-primary border border-border-primary rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-text-primary mb-2">Resilience</h3>
            <p class="text-text-secondary">
              Implements circuit breakers, retries, and graceful degradation
            </p>
          </div>
          <div class="bg-surface-primary border border-border-primary rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-text-primary mb-2">Observability</h3>
            <p class="text-text-secondary">
              Comprehensive logging, monitoring, and distributed tracing
            </p>
          </div>
          <div class="bg-surface-primary border border-border-primary rounded-2xl p-6">
            <h3 class="text-lg font-semibold text-text-primary mb-2">Performance</h3>
            <p class="text-text-secondary">
              Optimized for low latency with caching and efficient data access
            </p>
          </div>
        </div>
      </section>

      <!-- Related Projects -->
      <section class="pt-12 border-t border-border-primary">
        <div class="text-center">
          <h2 class="text-2xl font-bold text-text-primary mb-4">Explore More Projects</h2>
          <a
            href="/projects"
            class="inline-flex items-center gap-2 px-6 py-3 bg-accent-blue text-white rounded-xl hover:bg-accent-blueHover transition-all duration-200 font-medium"
          >
            View All Projects
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
