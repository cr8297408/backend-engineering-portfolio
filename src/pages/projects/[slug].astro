---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/react/ui/Navbar';
import { ArchitectureDiagram } from '../../components/react/diagram/ArchitectureDiagram';
import { withBase } from '../../lib/paths';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

export async function getStaticPaths() {
  const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
  const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));

  return projectFiles.map(file => {
    const content = readFileSync(join(projectsDir, file), 'utf-8');
    const project = JSON.parse(content);
    return {
      params: { slug: project.slug },
      props: { project }
    };
  });
}

const { project } = Astro.props;
---

<Layout title={`${project.title} - Backend Engineer Portfolio`} description={project.longDescription}>
  <!-- Navbar -->
  <Navbar client:load />

  <div class="min-h-screen bg-black px-4 py-24">
    <div class="max-w-7xl mx-auto">
      <!-- Back Button -->
      <a
        href={withBase("/projects")}
        class="inline-flex items-center text-white/60 hover:text-white transition-all duration-200 mb-8"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Projects
      </a>

      <!-- Project Header -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-6">
          <div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-medium text-white mb-4">{project.title}</h1>
            <p class="text-xl text-white/60 max-w-3xl">{project.longDescription}</p>
          </div>
          {project.featured && (
            <span class="inline-block px-4 py-2 bg-white/10 text-white text-sm font-medium rounded-full border border-white/20">
              Featured
            </span>
          )}
        </div>

        <!-- Technologies -->
        <div class="flex flex-wrap gap-2 mb-8">
          {project.technologies.map((tech: string) => (
            <span class="px-4 py-2 bg-white/5 text-white/70 text-sm rounded-full border border-white/10">
              {tech}
            </span>
          ))}
        </div>

        <!-- Project Links -->
        <div class="flex flex-wrap gap-3">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white/10 text-white rounded-full hover:bg-white/20 transition-all duration-300 font-medium border border-white/20"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
            Live Demo
          </a>
        )}
        </div>
      </div>

      <!-- Architecture Diagram Section -->
      {project.diagrams?.architecture && (
        <section class="mb-20">
          <div class="mb-8">
            <h2 class="text-2xl md:text-3xl font-medium text-white mb-3">System Architecture</h2>
            <p class="text-white/60">
              Interactive diagram showing the components and their relationships
            </p>
          </div>
          <div class="bg-neutral-950 rounded-3xl border border-white/10 overflow-hidden">
            <ArchitectureDiagram
              diagram={project.diagrams.architecture}
              client:visible
            />
          </div>
        </section>
      )}

      <!-- Infrastructure Diagram Section -->
      {project.diagrams?.infrastructure && (
        <section class="mb-20">
          <div class="mb-8">
            <h2 class="text-2xl md:text-3xl font-medium text-white mb-3">Cloud Infrastructure</h2>
            <p class="text-white/60">
              How it is provisioned, deployed and exposed in production
            </p>
          </div>
          <div class="bg-neutral-950 rounded-3xl border border-white/10 overflow-hidden">
            <ArchitectureDiagram
              diagram={project.diagrams.infrastructure}
              client:visible
            />
          </div>
        </section>
      )}

      <!-- Key Features -->
      {project.keyFeatures && project.keyFeatures.length > 0 && (
        <section class="mb-20">
          <h2 class="text-2xl md:text-3xl font-medium text-white mb-8">What makes it work</h2>
          <div class="grid md:grid-cols-2 gap-4">
            {project.keyFeatures.map((feature: { title: string; description: string }) => (
              <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.05] to-transparent p-8 transition-colors duration-300 hover:border-white/25">
                <h3 class="text-lg font-medium text-white mb-3">{feature.title}</h3>
                <p class="text-white/55 text-sm leading-relaxed">{feature.description}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Related Projects -->
      <section class="pt-16 border-t border-white/10">
        <div class="text-center">
          <h2 class="text-2xl font-medium text-white mb-6">Explore More Projects</h2>
          <a
            href={withBase("/projects")}
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black rounded-full hover:bg-white/90 transition-all duration-300 font-medium"
          >
            View All Projects
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
