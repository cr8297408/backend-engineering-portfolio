---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/react/ui/Navbar';
import { ProjectCard } from '../components/react/ui/ProjectCard';
import { readFileSync, readdirSync } from 'fs';
import { join } from 'path';

// Load all projects
const projectsDir = join(process.cwd(), 'public', 'data', 'projects');
const projectFiles = readdirSync(projectsDir).filter(f => f.endsWith('.json'));
const projects = projectFiles.map(file => {
  const content = readFileSync(join(projectsDir, file), 'utf-8');
  return JSON.parse(content);
});
---

<Layout title="All Projects - Backend Engineer Portfolio">
  <!-- Navbar -->
  <Navbar client:load />

  <div class="min-h-screen px-4 py-24">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          All Projects
        </h1>
        <p class="text-xl text-text-secondary max-w-2xl mx-auto">
          Explore my backend engineering work, infrastructure designs, and architectural solutions
        </p>
      </div>

      <!-- Projects Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <ProjectCard
            title={project.title}
            description={project.longDescription}
            technologies={project.technologies}
            slug={project.slug}
            featured={project.featured}
            github={project.github}
            client:load
          />
        ))}
      </div>

      <!-- Back to Home -->
      <div class="mt-16 text-center">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 px-6 py-3 bg-surface-primary text-accent-blue rounded-xl hover:bg-surface-secondary transition-all duration-200 font-medium border border-accent-blue"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          Back to Home
        </a>
      </div>
    </div>
  </div>
</Layout>
