---
/**
 * Ambient hero background: a layered service topology with request pulses
 * travelling its edges — the same visual language as the React Flow diagrams
 * the portfolio is built around (see `dashdraw` in global.css).
 *
 * Read top to bottom it is the shape of a real system: clients fan into an
 * entry point, the entry point fans out to services, services fan down to
 * stores (drawn as squares). Purely decorative, so it is hidden from
 * assistive tech. No JS and no network cost: it replaces a 19 MB video.
 */
---

<div class="hero-topology" aria-hidden="true">
  <svg viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="node-core">
        <stop offset="0%" stop-color="#BFDBFE" />
        <stop offset="100%" stop-color="#3B82F6" />
      </radialGradient>
    </defs>

    <g class="edges" fill="none" stroke="#60A5FA" stroke-width="1.1">
      <!-- clients -> entry -->
      <path d="M 300 140 L 720 110" />
      <path d="M 1140 140 L 720 110" />
      <!-- entry -> services -->
      <path d="M 720 110 L 170 360" />
      <path d="M 720 110 L 520 330" />
      <path d="M 720 110 L 930 330" />
      <path d="M 720 110 L 1290 360" />
      <!-- services -> services -->
      <path d="M 170 360 L 350 580" />
      <path d="M 520 330 L 350 580" />
      <path d="M 520 330 L 720 560" />
      <path d="M 930 330 L 720 560" />
      <path d="M 930 330 L 1090 580" />
      <path d="M 1290 360 L 1090 580" />
      <!-- services -> stores -->
      <path d="M 350 580 L 250 800" />
      <path d="M 350 580 L 720 790" />
      <path d="M 720 560 L 720 790" />
      <path d="M 1090 580 L 720 790" />
      <path d="M 1090 580 L 1200 800" />
    </g>

    <!-- One short dash per edge, travelling it on a stagger -->
    <g class="pulses" fill="none" stroke="#DBEAFE" stroke-width="2.4" stroke-linecap="round">
      <path pathLength="100" d="M 300 140 L 720 110" style="--dur: 4.5s; --delay: 0s" />
      <path pathLength="100" d="M 720 110 L 170 360" style="--dur: 6s; --delay: 1.1s" />
      <path pathLength="100" d="M 720 110 L 1290 360" style="--dur: 6.5s; --delay: 2.6s" />
      <path pathLength="100" d="M 520 330 L 720 560" style="--dur: 5s; --delay: 0.6s" />
      <path pathLength="100" d="M 930 330 L 1090 580" style="--dur: 5.4s; --delay: 3.2s" />
      <path pathLength="100" d="M 720 560 L 720 790" style="--dur: 4.2s; --delay: 1.9s" />
      <path pathLength="100" d="M 1090 580 L 720 790" style="--dur: 7s; --delay: 4s" />
    </g>

    <g class="nodes">
      <!-- clients + entry -->
      <circle cx="300" cy="140" r="4" />
      <circle cx="1140" cy="140" r="4" />
      <circle cx="720" cy="110" r="7" />
      <!-- services -->
      <circle cx="170" cy="360" r="5" />
      <circle cx="520" cy="330" r="6" />
      <circle cx="930" cy="330" r="6" />
      <circle cx="1290" cy="360" r="5" />
      <circle cx="350" cy="580" r="5" />
      <circle cx="720" cy="560" r="6" />
      <circle cx="1090" cy="580" r="5" />
    </g>

    <!-- Stores read as squares, the way they do in the project diagrams -->
    <g class="stores">
      <rect x="243" y="793" width="14" height="14" rx="3" />
      <rect x="712" y="783" width="16" height="16" rx="3" />
      <rect x="1193" y="793" width="14" height="14" rx="3" />
    </g>
  </svg>

  <!-- Scrim: guarantees headline contrast regardless of what sits behind it -->
  <div class="hero-scrim"></div>
</div>

<style>
  .hero-topology {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background:
      radial-gradient(
        70% 60% at 50% 40%,
        rgb(26 51 96 / 0.5) 0%,
        rgb(9 15 32 / 0.45) 50%,
        transparent 100%
      ),
      #000;
  }

  .hero-topology svg {
    width: 100%;
    height: 100%;
  }

  .edges {
    opacity: 0.35;
  }

  .nodes circle {
    fill: url(#node-core);
    opacity: 0.8;
  }

  .stores rect {
    fill: none;
    stroke: #60a5fa;
    stroke-width: 1.6;
    opacity: 0.75;
  }

  /* A short dash sliding the full length of each path reads as a request in
     flight. The `pathLength="100"` attribute normalises every edge to 100
     units, so one keyframe set works for paths of very different lengths. */
  .pulses path {
    stroke-dasharray: 3 97;
    stroke-dashoffset: 100;
    opacity: 0.85;
    animation: packet var(--dur, 5s) linear var(--delay, 0s) infinite;
  }

  @keyframes packet {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Wide, many-stopped falloff. Fewer stops banded visibly across the hero. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        75% 65% at 50% 46%,
        rgb(0 0 0 / 0.9) 0%,
        rgb(0 0 0 / 0.78) 30%,
        rgb(0 0 0 / 0.5) 55%,
        rgb(0 0 0 / 0.22) 75%,
        transparent 100%
      ),
      linear-gradient(
        to bottom,
        rgb(0 0 0 / 0.55) 0%,
        rgb(0 0 0 / 0.15) 18%,
        rgb(0 0 0 / 0.15) 55%,
        rgb(0 0 0 / 0.6) 80%,
        #000 100%
      );
  }

  @media (prefers-reduced-motion: reduce) {
    .pulses path {
      animation: none;
      stroke-dashoffset: 50;
    }
  }
</style>
